{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aiokin;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "Issuer": "AioKinApi",
    "Audience": [ "AioKinApi" ],
    "Key": "dev-only-key-do-not-use-in-production-change-me-32b",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "AioKin:"
  },

  "Frontend": {
    "Origin": "http://localhost:3000"
  }
}
