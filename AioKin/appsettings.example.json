{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": []
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aiokin;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "Issuer": "AioKinApi",
    "Audience": ["AioKinApi"],
    "Key": "your-at-least-32-chars-long-jwt-secret-key-here",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "RefreshTokenAbsoluteExpiryDays": 60
  },

  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "family"
  },

  "Email": {
    "ApiKey": "",
    "SenderEmail": "no-reply@aiokin.com",
    "SenderName": "AioKin",
    "SupportEmail": "support@aiokin.com",
    "BaseUrl": "https://api.brevo.com/v3/"
  },

  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    }
  },

  "Frontend": {
    "Origin": "*"
  }
}
